<Project>
  <!-- Keep dotnetup's telemetry dependencies aligned with the SDK pipeline. Package versions are expanded after
       all properties are evaluated, so importing this file from a project overrides eng/Versions.props for that
       project only. -->
  <PropertyGroup>
    <AzureMonitorOpenTelemetryExporterPackageVersion>1.10.0</AzureMonitorOpenTelemetryExporterPackageVersion>
    <OpenTelemetryDotnetPackageVersion>1.18.0</OpenTelemetryDotnetPackageVersion>
    <OpenTelemetryPersistentStoragePackageVersion>1.1.1</OpenTelemetryPersistentStoragePackageVersion>
  </PropertyGroup>
</Project>
