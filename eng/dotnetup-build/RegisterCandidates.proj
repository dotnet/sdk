<Project>
  <Import Project="$(DotnetupArcadeToolsetDir)PublishBuildAssets.proj" />

  <UsingTask TaskName="Microsoft.DotNet.Tools.Dotnetup.BuildTasks.PrepareDotnetupCandidateAssetIds"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)PrepareCandidateAssetIds.cs" />
    </Task>
  </UsingTask>

  <Target Name="ValidateCandidates">
    <Error Condition="'$(ManifestsPath)' == ''" Text="ManifestsPath is required." />
    <PrepareDotnetupCandidateAssetIds ManifestsPath="$(ManifestsPath)" />
  </Target>

  <Target Name="PrepareCandidateAssetIds">
    <PrepareDotnetupCandidateAssetIds ManifestPath="$(ManifestPath)" OutputDirectory="$(AssetManifestsPath)" />
    <Copy SourceFiles="$(ManifestPath)" DestinationFiles="$(AssetManifestsPath)\MergedManifest.xml" />
  </Target>

  <Target Name="RegisterCandidates" DependsOnTargets="ValidateCandidates">
    <Error Condition="'$(AssetManifestsPath)' == ''" Text="AssetManifestsPath is required." />
    <Error Condition="'$(MaestroApiEndpoint)' == ''" Text="MaestroApiEndpoint is required." />
    <PublishBuildToMaestro ManifestsPath="$(ManifestsPath)"
                          MaestroApiEndpoint="$(MaestroApiEndpoint)"
                          RepoRoot="$(RepoRoot)"
                          AssetVersion="$(Version)" />
    <PrepareDotnetupCandidateAssetIds ManifestPath="$(BUILD_STAGINGDIRECTORY)\MergedManifest.xml"
                                     OutputDirectory="$(AssetManifestsPath)" />
    <Copy SourceFiles="$(BUILD_STAGINGDIRECTORY)\MergedManifest.xml"
          DestinationFiles="$(AssetManifestsPath)\MergedManifest.xml" />
  </Target>
</Project>
