<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>$(SdkTargetFramework)</TargetFramework>
    <MSTestParallelizeScope>ClassLevel</MSTestParallelizeScope>
    <StrongNameKeyId>MicrosoftAspNetCore</StrongNameKeyId>
    <!-- The real-Pack manifest test restores the NoTargets SDK from a local feed. global.json is the
         only place that defines its version. -->
    <_ManifestNoTargetsVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(RepoRoot)global.json')), '&quot;Microsoft.Build.NoTargets&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</_ManifestNoTargetsVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\Tasks\sdk-tasks\sdk-tasks.csproj" />
    <ProjectReference Include="..\Microsoft.NET.TestFramework.MSTest\Microsoft.NET.TestFramework.MSTest.csproj" />
    <PackageReference Include="Microsoft.DotNet.Build.Tasks.Templating" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WixToolset.Dtf.WindowsInstaller" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="Microsoft.Build.NoTargets" Version="[$(_ManifestNoTargetsVersion)]" />
    <Content Include="$(NuGetPackageRoot)microsoft.build.notargets\$(_ManifestNoTargetsVersion)\microsoft.build.notargets.$(_ManifestNoTargetsVersion).nupkg"
             Link="ManifestPackages\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)src\Workloads\Manifests\Microsoft.NET.Workload.Mono.Toolchain.Current.Manifest\**"
             Link="ManifestProducers\Microsoft.NET.Workload.Mono.Toolchain.Current.Manifest\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_DotNet_Build_Tasks_Templating)\tools\net\*"
             Link="ManifestGeneration\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageDownload Include="Microsoft.WixToolset.Sdk" Version="[$(MicrosoftWixToolsetSdkVersion)]" />
    <PackageDownload Include="Microsoft.WixToolset.Heat" Version="[$(MicrosoftWixToolsetSdkVersion)]" />
    <PackageDownload Include="Microsoft.WixToolset.Util.wixext" Version="[$(MicrosoftWixToolsetSdkVersion)]" />
    <PackageDownload Include="Microsoft.WixToolset.UI.wixext" Version="[$(MicrosoftWixToolsetSdkVersion)]" />
    <PackageDownload Include="Microsoft.WixToolset.Dependency.wixext" Version="[$(MicrosoftWixToolsetSdkVersion)]" />
    <PackageDownload Include="Microsoft.DotNet.Build.Tasks.Installers" Version="[$(MicrosoftDotNetBuildTasksInstallersPackageVersion)]" />

    <Content Include="$(RepoRoot)src\Layout\pkg\windows\Directory.Build.props;
                      $(RepoRoot)src\Layout\pkg\windows\Directory.Build.targets;
                      $(RepoRoot)src\Layout\pkg\windows\StableFileIdForApphostTransform.xslt;
                      $(RepoRoot)src\Layout\pkg\windows\dotnet.ico;
                      $(RepoRoot)src\Layout\pkg\windows\dummyeula.rtf"
             Link="TemplateMsiAuthoring\pkg\windows\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)src\Layout\pkg\windows\msis\Directory.Build.props;
                      $(RepoRoot)src\Layout\pkg\windows\msis\Directory.Build.targets;
                      $(RepoRoot)src\Layout\pkg\windows\msis\directories.wxs;
                      $(RepoRoot)src\Layout\pkg\windows\msis\provider.wxs"
             Link="TemplateMsiAuthoring\pkg\windows\msis\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)src\Layout\pkg\windows\msis\templates\**\*"
             Exclude="$(RepoRoot)src\Layout\pkg\windows\msis\templates\**\bin\**\*;
                      $(RepoRoot)src\Layout\pkg\windows\msis\templates\**\obj\**\*"
             Link="TemplateMsiAuthoring\pkg\windows\msis\templates\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="$(NuGetPackageRoot)microsoft.wixtoolset.sdk\$(MicrosoftWixToolsetSdkVersion)\microsoft.wixtoolset.sdk.$(MicrosoftWixToolsetSdkVersion).nupkg"
             Link="WixPackages\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.wixtoolset.heat\$(MicrosoftWixToolsetSdkVersion)\microsoft.wixtoolset.heat.$(MicrosoftWixToolsetSdkVersion).nupkg"
             Link="WixPackages\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.wixtoolset.util.wixext\$(MicrosoftWixToolsetSdkVersion)\microsoft.wixtoolset.util.wixext.$(MicrosoftWixToolsetSdkVersion).nupkg"
             Link="WixPackages\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.wixtoolset.ui.wixext\$(MicrosoftWixToolsetSdkVersion)\microsoft.wixtoolset.ui.wixext.$(MicrosoftWixToolsetSdkVersion).nupkg"
             Link="WixPackages\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.wixtoolset.dependency.wixext\$(MicrosoftWixToolsetSdkVersion)\microsoft.wixtoolset.dependency.wixext.$(MicrosoftWixToolsetSdkVersion).nupkg"
             Link="WixPackages\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.dotnet.build.tasks.installers\$(MicrosoftDotNetBuildTasksInstallersPackageVersion)\microsoft.dotnet.build.tasks.installers.$(MicrosoftDotNetBuildTasksInstallersPackageVersion).nupkg"
             Link="WixPackages\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>