<Project>
  <!-- This process fixture targets the test assembly's framework and needs the repo's bootstrap SDK targeting support. -->
  <PropertyGroup>
    <DirectoryBuildPropsPath>$(MSBuildThisFileDirectory)..\..\..\Directory.Build.props</DirectoryBuildPropsPath>
    <DirectoryBuildTargetsPath>$(MSBuildThisFileDirectory)..\..\..\Directory.Build.targets</DirectoryBuildTargetsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(CurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>false</SelfContained>
    <UseAppHost>true</UseAppHost>
    <AppHostDotNetSearch>AppRelative</AppHostDotNetSearch>
  </PropertyGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>