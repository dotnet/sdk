<Project Sdk="Microsoft.NET.Sdk">
  <!-- Keep transitive telemetry packages at the versions dotnetup ships with. -->
  <Import Project="$(RepoRoot)eng\DotnetupTelemetryPackageVersions.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(SdkTargetFramework)</TargetFramework>
    <AssemblyName>dotnetup</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\Installer\dotnetup.Library\dotnetup.Library.csproj" />
  </ItemGroup>
</Project>
