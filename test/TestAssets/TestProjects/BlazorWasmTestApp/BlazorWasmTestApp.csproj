<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), testAsset.props))\testAsset.props" />

  <PropertyGroup>
    <CurrentTargetFramework Condition="'$(CurrentTargetFramework)' == ''">net$(NETCoreAppMaximumVersion)</CurrentTargetFramework>
    <TargetFramework>$(CurrentTargetFramework)</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>

    <EnableMSTestRunner>true</EnableMSTestRunner>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>

    <_BlazorBrotliCompressionLevel>NoCompression</_BlazorBrotliCompressionLevel>

    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <DefineConstants Condition="'$(BrowserWasmUseMtpPackage)' == 'true'">$(DefineConstants);BROWSER_WASM_MTP_PACKAGE</DefineConstants>
    <TestingPlatformBrowserGenerateHostAssets Condition="'$(BrowserWasmUseMtpPackage)' == 'true'">false</TestingPlatformBrowserGenerateHostAssets>
    <RestoreAdditionalProjectSources Condition="'$(BrowserWasmMtpPackageSource)' != ''">$(RestoreAdditionalProjectSources);$(BrowserWasmMtpPackageSource)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(MicrosoftAspNetCoreAppRefPackageVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="$(MicrosoftAspNetCoreAppRefPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="MSTest" Version="$(MSTestVersion)" />
    <PackageReference Include="Microsoft.Testing.Platform.Browser"
                      Version="$(BrowserWasmMtpPackageVersion)"
                      Condition="'$(BrowserWasmUseMtpPackage)' == 'true'" />
  </ItemGroup>

  <Target Name="_ConfigureBlazorBrowserTestHost"
          AfterTargets="_CaptureTestingPlatformBrowserHost"
          BeforeTargets="_ConfigureTestingPlatformBrowserRun"
          Condition="'$(BrowserWasmUseMtpPackage)' == 'true'">
    <PropertyGroup>
      <TestingPlatformBrowserHostArguments>$(_TestingPlatformBrowserComputedHostArguments) --urls http://127.0.0.1:0</TestingPlatformBrowserHostArguments>
    </PropertyGroup>
  </Target>

</Project>
