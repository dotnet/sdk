<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>$(SdkTargetFramework)</TargetFramework>
    <!-- Each test class owns a repository clone; inherited methods within a class share that clone. -->
    <MSTestParallelizeScope>ClassLevel</MSTestParallelizeScope>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.NET.TestFramework.MSTest\Microsoft.NET.TestFramework.MSTest.csproj" />
  </ItemGroup>

</Project>
