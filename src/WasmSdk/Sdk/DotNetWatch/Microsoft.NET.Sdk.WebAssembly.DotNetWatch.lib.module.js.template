// Activates the browser tools client. Added when Hot Reload build outputs are enabled.
//
// The build provides a stable settings asset. Watch enables it after compilation, without changing
// application source or passing activation state through the build.

// Substituted by Microsoft.NET.Sdk.StaticWebAssets.DotNetWatch.targets. True only when the target
// framework's built-in WebAssembly Hot Reload agent has to be enabled explicitly.
const useRuntimeHotReloadAgent = __RUNTIME_HOT_RELOAD_AGENT__;

// Substituted by Microsoft.NET.Sdk.StaticWebAssets.DotNetWatch.targets. True when the SDK ships the
// WebAssembly Hot Reload agent assembly and this initializer must install its apply API.
const useSdkHotReloadAgent = __SDK_HOT_RELOAD_AGENT__;

// Substituted by Microsoft.NET.Sdk.StaticWebAssets.DotNetWatch.targets.
const settingsPath = '__SETTINGS_PATH__';
const settingsRequestTimeoutMilliseconds = 5000;

// Substituted by Microsoft.NET.Sdk.StaticWebAssets.DotNetWatch.targets. The configuration is app
// hosted and sits next to this initializer, so resolving it relative to import.meta.url keeps it
// correct under any static web asset base path or fingerprinting scheme.
const configModulePath = '__CONFIG_MODULE__';

let hotReloadEnabled = false;

export async function onRuntimeConfigLoaded(config) {
    if (config.debugLevel === 0) {
        return;
    }

    hotReloadEnabled = await isHotReloadEnabled();
    if (!hotReloadEnabled) {
        return;
    }

    // Activates the SDK Hot Reload agent on .NET 10+.
    // Do not use __ASPNETCORE_BROWSER_TOOLS for this: .NET 8 interprets it as a request to load the
    // legacy application-hosted blazor-hotreload.js module, which the SDK no longer produces.
    config.environmentVariables["DOTNET_MODIFIABLE_ASSEMBLIES"] ??= "debug";
    config.environmentVariables["__DOTNET_WATCH_BROWSER_TOOLS"] ??= "true";

    if (useRuntimeHotReloadAgent) {
        // .NET 9 keeps its Hot Reload agent null unless WebAssemblyHotReload.InitializeAsync runs, and
        // that only happens when this variable is set. Without it applyHotReloadDeltas returns an empty
        // log and silently applies nothing, so an edit is acknowledged but never takes effect.
        config.environmentVariables["__ASPNETCORE_BROWSER_TOOLS"] ??= "true";
    }

}

export async function onRuntimeReady(runtime) {
    if (!hotReloadEnabled) {
        return;
    }

    if (useSdkHotReloadAgent) {
        const agent = hotReloadAgentSignal();
        try {
            const exports = await runtime.getAssemblyExports("Microsoft.DotNet.HotReload.WebAssembly.Browser");
            await exports.Microsoft.DotNet.HotReload.WebAssembly.Browser.WebAssemblyHotReload.InitializeAsync(document.baseURI);

            agent.applyHotReloadDeltas = (deltas, loggingLevel) => {
                const result = exports.Microsoft.DotNet.HotReload.WebAssembly.Browser.WebAssemblyHotReload.ApplyHotReloadDeltas(JSON.stringify(deltas), loggingLevel);
                return result ? JSON.parse(result) : [];
            };

            agent.getApplyUpdateCapabilities = () => {
                return exports.Microsoft.DotNet.HotReload.WebAssembly.Browser.WebAssemblyHotReload.GetApplyUpdateCapabilities() ?? '';
            };
        } catch (error) {
            console.debug('Unable to initialize the dotnet-watch Hot Reload agent.', error);
        } finally {
            // Release the browser tools client even when agent initialization failed. It will report
            // an apply failure instead of dropping replayed updates.
            agent.setReady();
        }
    }

    try {
        await import(new URL(configModulePath, import.meta.url).href);
    } catch (error) {
        console.debug('Unable to load the dotnet-watch browser tools.', error);
    }
}

// Shared with the browser tools client. Library initializer module evaluation order is not
// guaranteed, so either module may create the rendezvous object first.
function hotReloadAgentSignal() {
    const agent = globalThis.__DOTNET_WATCH_HOT_RELOAD_AGENT ||= {};
    if (!agent.ready) {
        agent.ready = new Promise(resolve => { agent.setReady = resolve; });
    }

    return agent;
}

async function isHotReloadEnabled() {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), settingsRequestTimeoutMilliseconds);

    try {
        // Development static assets can answer a cached build-time ETag with 304 before
        // checking the current file. A fresh validator forces the current bytes to be sent.
        const response = await fetch(settingsPath, {
            cache: 'no-store',
            headers: { 'If-None-Match': `"browser-tools-${crypto.randomUUID()}"` },
            signal: controller.signal
        });
        if (!response.ok) {
            return false;
        }

        const settings = await response.json();
        return settings?.hotReload === true;
    } catch (error) {
        console.debug('Unable to read the dotnet-watch browser tools settings.', error);
        return false;
    } finally {
        clearTimeout(timeout);
    }
}
