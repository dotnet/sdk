<!--
***********************************************************************************************
Microsoft.NET.Sdk.StaticWebAssets.DotNetWatch.targets

WARNING:  DO NOT MODIFY this file unless you are knowledgeable about MSBuild and have
          created a backup copy.  Incorrect changes to this file will make it
          impossible to load or build your projects from the command-line or the IDE.

Copyright (c) .NET Foundation. All rights reserved.
***********************************************************************************************
-->
<Project>

  <UsingTask
    TaskName="Microsoft.AspNetCore.StaticWebAssets.Tasks.EnsureDotNetWatchBrowserToolsKey"
    AssemblyFile="$(StaticWebAssetsSdkBuildTasksAssembly)" />

  <PropertyGroup>
    <!-- Fixed, same-origin route the dotnet-watch provider is forwarded on. Must match
         Microsoft.DotNet.HotReload.BrowserToolsProtocol.RoutePrefix. -->
    <DotNetWatchBrowserToolsRoutePrefix Condition="'$(DotNetWatchBrowserToolsRoutePrefix)' == ''">/_framework/dotnet-browser-tools</DotNetWatchBrowserToolsRoutePrefix>

    <!-- Route of the settings document, relative to the '_framework' folder the browser tools assets
         live in. Must match Microsoft.DotNet.Watch.BrowserToolsBuildOutputs.SettingsRelativeRoute. -->
    <DotNetWatchBrowserToolsSettingsRelativeRoute Condition="'$(DotNetWatchBrowserToolsSettingsRelativeRoute)' == ''">browser-tools/hot-reload-settings.json</DotNetWatchBrowserToolsSettingsRelativeRoute>

    <!--
      The browser tools assets are development only. They are produced by ordinary development
      builds - not only by builds that dotnet-watch drives - because the browser tools key pair has
      to exist before dotnet-watch can key its provider, and because the settings document has to be
      part of the application before dotnet-watch can flip it. They are build only assets that never
      reach publish output, and they are inert unless the settings document says otherwise.

      Set DotNetWatchBrowserToolsEnabled explicitly to opt out.
    -->
    <DotNetWatchBrowserToolsEnabled Condition="'$(DotNetWatchBrowserToolsEnabled)' == ''">true</DotNetWatchBrowserToolsEnabled>

    <!--
      The settings document is rewritten in place by dotnet-watch while the application is running,
      so a compressed alternative would immediately be stale and could be negotiated in preference
      to the document the application serves from the intermediate output.
    -->
    <CompressionExcludePatterns>$(CompressionExcludePatterns);**/$(DotNetWatchBrowserToolsSettingsRelativeRoute)</CompressionExcludePatterns>
  </PropertyGroup>

  <!--
    Produces the dotnet-watch browser tools assets for the current project:

      * the SDK specific JS initializer, which fetches the settings document and activates the tools
        at the right point of the application lifecycle,
      * the browser tools client,
      * a generated configuration module that pins the provider's public key and routes, and
      * the settings document that decides, at runtime, whether the tools start at all.

    The client is served by the application rather than by the dotnet-watch provider on purpose.
    The browser authenticates the provider with the pinned public key, so accepting executable
    code from that same provider would make the authentication meaningless. For the same reason the
    key pair is produced by the build: a key that the provider handed to the application would let
    the provider authenticate itself.

    Only the public half of the key pair reaches a static web asset. The private half is written to a
    separate file in the intermediate output that is not a static web asset, is never served, and is
    read only by the dotnet-watch process. The assets are build only ('AssetKind=Build' and
    'CopyToPublishDirectory=Never') so that publish output never contains them.

    SDKs opt in by setting DotNetWatchBrowserToolsAssetPrefix and
    DotNetWatchBrowserToolsInitializerFile.
  -->
  <Target Name="_DefineDotNetWatchBrowserToolsAssets"
          BeforeTargets="ResolveProjectStaticWebAssets"
          DependsOnTargets="ResolveWebAssemblyProjectReferences;_DefineDotNetWatchBrowserToolsAssetsCore" />

  <Target Name="_DefineDotNetWatchBrowserToolsAssetsCore"
          DependsOnTargets="ResolveStaticWebAssetsConfiguration"
          Condition="'$(DesignTimeBuild)' != 'true'
            and '$(DotNetWatchBrowserToolsEnabled)' == 'true'
            and '$(DotNetWatchBrowserToolsAssetPrefix)' != ''
            and '$(StaticWebAssetsEnabled)' == 'true'
            and '$(JSModulesEnabled)' == 'true'
            and '$(TargetFrameworkIdentifier)' == '.NETCoreApp'
            and '@(WebAssemblyProjectReference)' == ''">

    <PropertyGroup>
      <!-- These four paths are a contract with dotnet-watch. Keep them in sync with
           Microsoft.DotNet.Watch.BrowserToolsBuildOutputs. -->
      <_DotNetWatchBrowserToolsIntermediatePath>$(IntermediateOutputPath)dotnet-watch\</_DotNetWatchBrowserToolsIntermediatePath>
      <_DotNetWatchBrowserToolsSettingsFile>$(_DotNetWatchBrowserToolsIntermediatePath)hot-reload-settings.json</_DotNetWatchBrowserToolsSettingsFile>
      <_DotNetWatchBrowserToolsPublicKeyFile>$(_DotNetWatchBrowserToolsIntermediatePath)browser-tools-key.public.json</_DotNetWatchBrowserToolsPublicKeyFile>
      <_DotNetWatchBrowserToolsPrivateKeyFile>$(_DotNetWatchBrowserToolsIntermediatePath)browser-tools-key.private.json</_DotNetWatchBrowserToolsPrivateKeyFile>

      <_DotNetWatchBrowserToolsInitializerFileName>$(DotNetWatchBrowserToolsAssetPrefix).lib.module.js</_DotNetWatchBrowserToolsInitializerFileName>
      <_DotNetWatchBrowserToolsClientFileName>$(DotNetWatchBrowserToolsAssetPrefix).BrowserTools.js</_DotNetWatchBrowserToolsClientFileName>
      <_DotNetWatchBrowserToolsConfigFileName>$(DotNetWatchBrowserToolsAssetPrefix).BrowserTools.Config.js</_DotNetWatchBrowserToolsConfigFileName>
      <_DotNetWatchBrowserToolsClientSource>$(MSBuildThisFileDirectory)DotNetWatch\dotnet-watch-browser-tools.js</_DotNetWatchBrowserToolsClientSource>
      <_DotNetWatchBrowserToolsConfigTemplate>$(MSBuildThisFileDirectory)DotNetWatch\dotnet-watch-browser-tools.config.js.template</_DotNetWatchBrowserToolsConfigTemplate>

      <!--
        .NET 9.0 is the only target framework whose built-in WebAssembly Hot Reload agent has to be turned
        on explicitly. Microsoft.AspNetCore.Components.WebAssembly.HotReload.WebAssemblyHotReload only
        creates its agent from InitializeAsync, which runs when __ASPNETCORE_BROWSER_TOOLS is set, and
        every apply entry point returns without applying anything while that agent is null.

        .NET 8.0 must not set it: its agent is created lazily by the apply entry point itself, and its
        InitializeAsync additionally imports the application hosted blazor-hotreload.js module that this
        SDK no longer produces. .NET 10.0 and later ship the Hot Reload agent with the SDK instead.
      -->
      <_DotNetWatchBrowserToolsRuntimeHotReloadAgent>false</_DotNetWatchBrowserToolsRuntimeHotReloadAgent>
      <_DotNetWatchBrowserToolsRuntimeHotReloadAgent
        Condition="$([MSBuild]::VersionEquals('$(TargetFrameworkVersion)', '9.0'))">true</_DotNetWatchBrowserToolsRuntimeHotReloadAgent>
    </PropertyGroup>

    <MakeDir Directories="$(_DotNetWatchBrowserToolsIntermediatePath)" />

    <!--
      Ensures the key pair exists. A valid, matching pair is reused so that the generated
      configuration module stays byte identical across rebuilds; anything missing, malformed,
      mismatched or removed by a clean regenerates both halves.
    -->
    <EnsureDotNetWatchBrowserToolsKey
      PublicKeyPath="$(_DotNetWatchBrowserToolsPublicKeyFile)"
      PrivateKeyPath="$(_DotNetWatchBrowserToolsPrivateKeyFile)">
      <Output TaskParameter="PublicKey" PropertyName="_DotNetWatchBrowserToolsPublicKey" />
    </EnsureDotNetWatchBrowserToolsKey>

    <!--
      Every build resets the settings document to the disabled state, so an application that is
      built or run outside dotnet-watch never activates browser tools even if a previous
      dotnet-watch session left the document enabled. WriteOnlyWhenDifferent keeps the build
      incremental: when the document is already disabled, the file, and therefore every static web
      asset computed from it, is left untouched.
    -->
    <WriteLinesToFile
      File="$(_DotNetWatchBrowserToolsSettingsFile)"
      Lines="{ &quot;hotReload&quot;: false }"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />

    <!-- Copy to the intermediate folder to avoid duplicate identity when multiple projects reference the same SDK file -->
    <Copy
      SourceFiles="$(_DotNetWatchBrowserToolsClientSource)"
      DestinationFiles="$(_DotNetWatchBrowserToolsIntermediatePath)$(_DotNetWatchBrowserToolsClientFileName)"
      SkipUnchangedFiles="true" />

    <PropertyGroup>
      <_DotNetWatchBrowserToolsInitializerContent>$([System.IO.File]::ReadAllText('$(DotNetWatchBrowserToolsInitializerFile)'))</_DotNetWatchBrowserToolsInitializerContent>
      <_DotNetWatchBrowserToolsInitializerContent>$(_DotNetWatchBrowserToolsInitializerContent.Replace('__RUNTIME_HOT_RELOAD_AGENT__', '$(_DotNetWatchBrowserToolsRuntimeHotReloadAgent)'))</_DotNetWatchBrowserToolsInitializerContent>
      <_DotNetWatchBrowserToolsInitializerContent>$(_DotNetWatchBrowserToolsInitializerContent.Replace('__SETTINGS_PATH__', './$(DotNetWatchBrowserToolsSettingsRelativeRoute)'))</_DotNetWatchBrowserToolsInitializerContent>
      <_DotNetWatchBrowserToolsInitializerContent>$(_DotNetWatchBrowserToolsInitializerContent.Replace('__CONFIG_MODULE__', './$(_DotNetWatchBrowserToolsConfigFileName)'))</_DotNetWatchBrowserToolsInitializerContent>

      <_DotNetWatchBrowserToolsConfigContent>$([System.IO.File]::ReadAllText('$(_DotNetWatchBrowserToolsConfigTemplate)'))</_DotNetWatchBrowserToolsConfigContent>
      <_DotNetWatchBrowserToolsConfigContent>$(_DotNetWatchBrowserToolsConfigContent.Replace('__CLIENT_MODULE__', '$(_DotNetWatchBrowserToolsClientFileName)'))</_DotNetWatchBrowserToolsConfigContent>
      <_DotNetWatchBrowserToolsConfigContent>$(_DotNetWatchBrowserToolsConfigContent.Replace('__ROUTE_PREFIX__', '$(DotNetWatchBrowserToolsRoutePrefix)'))</_DotNetWatchBrowserToolsConfigContent>
      <_DotNetWatchBrowserToolsConfigContent>$(_DotNetWatchBrowserToolsConfigContent.Replace('__PUBLIC_KEY__', '$(_DotNetWatchBrowserToolsPublicKey)'))</_DotNetWatchBrowserToolsConfigContent>
    </PropertyGroup>

    <!-- WriteOnlyWhenDifferent keeps the build incremental: the key is stable as long as the key
         pair on disk stays valid, so rebuilds must not rewrite these files. -->
    <WriteLinesToFile
      File="$(_DotNetWatchBrowserToolsIntermediatePath)$(_DotNetWatchBrowserToolsInitializerFileName)"
      Lines="$([MSBuild]::Escape($(_DotNetWatchBrowserToolsInitializerContent)))"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />

    <WriteLinesToFile
      File="$(_DotNetWatchBrowserToolsIntermediatePath)$(_DotNetWatchBrowserToolsConfigFileName)"
      Lines="$([MSBuild]::Escape($(_DotNetWatchBrowserToolsConfigContent)))"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <_DotNetWatchBrowserToolsInitializer Include="$(_DotNetWatchBrowserToolsIntermediatePath)$(_DotNetWatchBrowserToolsInitializerFileName)">
        <RelativePath>_framework/$(_DotNetWatchBrowserToolsInitializerFileName)</RelativePath>
      </_DotNetWatchBrowserToolsInitializer>
      <_DotNetWatchBrowserToolsInitializer Update="@(_DotNetWatchBrowserToolsInitializer)">
        <OriginalItemSpec>%(Identity)</OriginalItemSpec>
      </_DotNetWatchBrowserToolsInitializer>

      <_DotNetWatchBrowserToolsClientModule Include="$(_DotNetWatchBrowserToolsIntermediatePath)$(_DotNetWatchBrowserToolsClientFileName)">
        <RelativePath>_framework/$(_DotNetWatchBrowserToolsClientFileName)</RelativePath>
      </_DotNetWatchBrowserToolsClientModule>
      <_DotNetWatchBrowserToolsClientModule Include="$(_DotNetWatchBrowserToolsIntermediatePath)$(_DotNetWatchBrowserToolsConfigFileName)">
        <RelativePath>_framework/$(_DotNetWatchBrowserToolsConfigFileName)</RelativePath>
      </_DotNetWatchBrowserToolsClientModule>
      <_DotNetWatchBrowserToolsClientModule Update="@(_DotNetWatchBrowserToolsClientModule)">
        <OriginalItemSpec>%(Identity)</OriginalItemSpec>
      </_DotNetWatchBrowserToolsClientModule>

      <_DotNetWatchBrowserToolsSettings Include="$(_DotNetWatchBrowserToolsSettingsFile)">
        <RelativePath>_framework/$(DotNetWatchBrowserToolsSettingsRelativeRoute)</RelativePath>
        <OriginalItemSpec>$(_DotNetWatchBrowserToolsSettingsFile)</OriginalItemSpec>
      </_DotNetWatchBrowserToolsSettings>

      <!-- The key files are not static web assets. They are tracked so that Clean removes them and
           no key material is left behind on disk. -->
      <FileWrites Include="@(_DotNetWatchBrowserToolsInitializer);@(_DotNetWatchBrowserToolsClientModule);@(_DotNetWatchBrowserToolsSettings)" />
      <FileWrites Include="$(_DotNetWatchBrowserToolsPublicKeyFile);$(_DotNetWatchBrowserToolsPrivateKeyFile)" />
    </ItemGroup>

    <DefineStaticWebAssets
      CandidateAssets="@(_DotNetWatchBrowserToolsInitializer)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      SourceId="$(PackageId)"
      SourceType="Computed"
      ContentRoot="$(_DotNetWatchBrowserToolsIntermediatePath)"
      BasePath="$(StaticWebAssetBasePath)"
      AssetKind="Build"
      CopyToPublishDirectory="Never"
      AssetTraitName="JSModule"
      AssetTraitValue="JSLibraryModule"
      PropertyOverrides="AssetTraitName;AssetTraitValue">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_DotNetWatchBrowserToolsInitializerAsset" />
    </DefineStaticWebAssets>

    <!-- The Web SDK relies on the JS modules pipeline to define the initializer endpoint and to add
         it to the JS initializer manifest, while the WebAssembly SDK defines the endpoint itself. -->
    <ItemGroup Condition="'$(DotNetWatchBrowserToolsRegisterInitializerAsJSModule)' == 'true'">
      <_JSModuleStaticWebAsset Include="@(_DotNetWatchBrowserToolsInitializerAsset)" />
    </ItemGroup>

    <DefineStaticWebAssetEndpoints
      Condition="'$(DotNetWatchBrowserToolsRegisterInitializerAsJSModule)' != 'true'"
      CandidateAssets="@(_DotNetWatchBrowserToolsInitializerAsset)"
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <!-- The client and the generated configuration are plain modules that the initializer and the
         browser refresh TagHelper import, so they must not be reported as JS initializers. -->
    <DefineStaticWebAssets
      CandidateAssets="@(_DotNetWatchBrowserToolsClientModule)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      SourceId="$(PackageId)"
      SourceType="Computed"
      ContentRoot="$(_DotNetWatchBrowserToolsIntermediatePath)"
      BasePath="$(StaticWebAssetBasePath)"
      AssetKind="Build"
      CopyToPublishDirectory="Never">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_DotNetWatchBrowserToolsClientAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints
      CandidateAssets="@(_DotNetWatchBrowserToolsClientAsset)"
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <!--
      The settings document is deliberately not fingerprinted: the initializer resolves it by a fixed
      route, and dotnet-watch rewrites the file the asset points at while the application is running.
      A fingerprinted route would pin the contents the build observed.
    -->
    <DefineStaticWebAssets
      CandidateAssets="@(_DotNetWatchBrowserToolsSettings)"
      FingerprintCandidates="false"
      SourceId="$(PackageId)"
      SourceType="Computed"
      ContentRoot="$(_DotNetWatchBrowserToolsIntermediatePath)"
      BasePath="$(StaticWebAssetBasePath)"
      AssetKind="Build"
      CopyToPublishDirectory="Never">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_DotNetWatchBrowserToolsSettingsAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints
      CandidateAssets="@(_DotNetWatchBrowserToolsSettingsAsset)"
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_DotNetWatchBrowserToolsSettingsEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <ItemGroup>
      <!-- The document changes while the application runs, so it must never be cached, not even for
           revalidation: a cached or revalidated response would report the state the build wrote. -->
      <_DotNetWatchBrowserToolsSettingsCacheOperation Include="Replace">
        <UpdateTarget>Header</UpdateTarget>
        <Name>Cache-Control</Name>
        <NewValue>no-store</NewValue>
      </_DotNetWatchBrowserToolsSettingsCacheOperation>
    </ItemGroup>

    <UpdateStaticWebAssetEndpoints
      EndpointsToUpdate="@(_DotNetWatchBrowserToolsSettingsEndpoint)"
      AllEndpoints="@(_DotNetWatchBrowserToolsSettingsEndpoint)"
      Operations="@(_DotNetWatchBrowserToolsSettingsCacheOperation)">
      <Output TaskParameter="UpdatedEndpoints" ItemName="_DotNetWatchBrowserToolsSettingsEndpointWithCacheControl" />
    </UpdateStaticWebAssetEndpoints>

    <ItemGroup>
      <StaticWebAssetEndpoint Include="@(_DotNetWatchBrowserToolsSettingsEndpointWithCacheControl)" />
    </ItemGroup>
  </Target>

</Project>
