<!--
***********************************************************************************************
Microsoft.NET.Sdk.StaticWebAssets.HotReload.targets

WARNING:  DO NOT MODIFY this file unless you are knowledgeable about MSBuild and have
          created a backup copy.  Incorrect changes to this file will make it
          impossible to load or build your projects from the command-line or the IDE.

Copyright (c) .NET Foundation. All rights reserved.
***********************************************************************************************
-->
<Project>

  <UsingTask
    TaskName="Microsoft.AspNetCore.StaticWebAssets.Tasks.EnsureHotReloadBrowserToolsKey"
    AssemblyFile="$(StaticWebAssetsSdkBuildTasksAssembly)" />

  <PropertyGroup>
    <!-- Fixed, same-origin route the Hot Reload provider is forwarded on. Must match
         Microsoft.DotNet.HotReload.BrowserToolsProtocol.RoutePrefix. -->
    <HotReloadBrowserToolsRoutePrefix Condition="'$(HotReloadBrowserToolsRoutePrefix)' == ''">/_framework/dotnet-browser-tools</HotReloadBrowserToolsRoutePrefix>
    <HotReloadBrowserToolsSettingsPath Condition="'$(HotReloadBrowserToolsSettingsPath)' == ''">$(HotReloadBrowserToolsRoutePrefix)/hot-reload-settings.json</HotReloadBrowserToolsSettingsPath>

    <!-- Imported after the opting-in SDK sets its browser tools properties so this is available during evaluation. -->
    <HotReloadBrowserToolsEnabled>false</HotReloadBrowserToolsEnabled>
    <HotReloadBrowserToolsEnabled Condition="'$(EnableHotReloadInRuntimeConfigDevFile)' == 'true' and
                                             '$(HotReloadBrowserToolsAssetPrefix)' != '' and
                                             '$(JSModulesEnabled)' == 'true'">true</HotReloadBrowserToolsEnabled>
  </PropertyGroup>

  <!--
    Produces the Hot Reload browser tools assets for the current project:

      * the SDK specific JS initializer, which activates the tools at the right point of the
        application lifecycle,
      * the browser tools client,
      * a generated configuration module that pins the provider's public key and routes.

    The client is served by the application rather than by the Hot Reload provider on purpose.
    The browser authenticates the provider with the pinned public key, so accepting executable
    code from that same provider would make the authentication meaningless. For the same reason the
    key pair is produced by the build: a key that the provider handed to the application would let
    the provider authenticate itself.

    Only the public half of the key pair reaches a static web asset. The private half is written to a
    separate file in the intermediate output that is not a static web asset, is never served, and is
    read only by the Hot Reload host process. The assets are build only ('AssetKind=Build' and
    'CopyToPublishDirectory=Never') so that publish output never contains them.

    SDKs opt in by setting HotReloadBrowserToolsAssetPrefix and
    HotReloadBrowserToolsInitializerFile.
  -->
  <Target Name="_DefineHotReloadBrowserToolsAssets"
          BeforeTargets="ResolveProjectStaticWebAssets"
          DependsOnTargets="ResolveWebAssemblyProjectReferences;_DefineHotReloadBrowserToolsAssetsCore" />

  <Target Name="_DefineHotReloadBrowserToolsAssetsCore"
          DependsOnTargets="ResolveStaticWebAssetsConfiguration"
          Condition="'$(DesignTimeBuild)' != 'true' and
                     '$(HotReloadBrowserToolsEnabled)' == 'true' and
                     '$(TargetFrameworkIdentifier)' == '.NETCoreApp' and
                     '@(WebAssemblyProjectReference)' == ''">

    <PropertyGroup>
      <!-- These paths are a Hot Reload contract. Keep them in sync with
           Microsoft.DotNet.HotReload.SharedSecretBuildOutputs. -->
      <_HotReloadBrowserToolsIntermediatePath>$(IntermediateOutputPath)HotReload\</_HotReloadBrowserToolsIntermediatePath>
      <_HotReloadBrowserToolsPublicKeyFile>$(_HotReloadBrowserToolsIntermediatePath)browser-tools-key.public.json</_HotReloadBrowserToolsPublicKeyFile>
      <_HotReloadBrowserToolsPrivateKeyFile>$(_HotReloadBrowserToolsIntermediatePath)browser-tools-key.private.json</_HotReloadBrowserToolsPrivateKeyFile>

      <_HotReloadBrowserToolsInitializerFileName>$(HotReloadBrowserToolsAssetPrefix).lib.module.js</_HotReloadBrowserToolsInitializerFileName>
      <_HotReloadBrowserToolsClientFileName>$(HotReloadBrowserToolsAssetPrefix).BrowserTools.js</_HotReloadBrowserToolsClientFileName>
      <_HotReloadBrowserToolsConfigFileName>$(HotReloadBrowserToolsAssetPrefix).BrowserTools.Config.js</_HotReloadBrowserToolsConfigFileName>
      <_HotReloadBrowserToolsClientSource>$(MSBuildThisFileDirectory)HotReload\HotReload-browser-tools.js</_HotReloadBrowserToolsClientSource>
      <_HotReloadBrowserToolsConfigTemplate>$(MSBuildThisFileDirectory)HotReload\HotReload-browser-tools.config.js.template</_HotReloadBrowserToolsConfigTemplate>

      <!--
        .NET 9.0 is the only target framework whose built-in WebAssembly Hot Reload agent has to be turned
        on explicitly. Microsoft.AspNetCore.Components.WebAssembly.HotReload.WebAssemblyHotReload only
        creates its agent from InitializeAsync, which runs when __ASPNETCORE_BROWSER_TOOLS is set, and
        every apply entry point returns without applying anything while that agent is null.

        .NET 8.0 must not set it: its agent is created lazily by the apply entry point itself, and its
        InitializeAsync additionally imports the application hosted blazor-hotreload.js module that this
        SDK no longer produces. .NET 10.0 and later ship the Hot Reload agent with the SDK instead.
      -->
      <_HotReloadBrowserToolsRuntimeHotReloadAgent>false</_HotReloadBrowserToolsRuntimeHotReloadAgent>
      <_HotReloadBrowserToolsRuntimeHotReloadAgent
        Condition="$([MSBuild]::VersionEquals('$(TargetFrameworkVersion)', '9.0'))">true</_HotReloadBrowserToolsRuntimeHotReloadAgent>
    </PropertyGroup>

    <MakeDir Directories="$(_HotReloadBrowserToolsIntermediatePath)" />

    <!--
      Ensures the key pair exists. A valid, matching pair is reused so that the generated
      configuration module stays byte identical across rebuilds; anything missing, malformed,
      mismatched or removed by a clean regenerates both halves.
    -->
    <EnsureHotReloadBrowserToolsKey
      PublicKeyPath="$(_HotReloadBrowserToolsPublicKeyFile)"
      PrivateKeyPath="$(_HotReloadBrowserToolsPrivateKeyFile)">
      <Output TaskParameter="PublicKey" PropertyName="_HotReloadBrowserToolsPublicKey" />
    </EnsureHotReloadBrowserToolsKey>

    <!-- Copy to the intermediate folder to avoid duplicate identity when multiple projects reference the same SDK file -->
    <Copy
      SourceFiles="$(_HotReloadBrowserToolsClientSource)"
      DestinationFiles="$(_HotReloadBrowserToolsIntermediatePath)$(_HotReloadBrowserToolsClientFileName)"
      SkipUnchangedFiles="true" />

    <PropertyGroup>
      <_HotReloadBrowserToolsInitializerContent>$([System.IO.File]::ReadAllText('$(HotReloadBrowserToolsInitializerFile)'))</_HotReloadBrowserToolsInitializerContent>
      <_HotReloadBrowserToolsInitializerContent>$(_HotReloadBrowserToolsInitializerContent.Replace('__RUNTIME_HOT_RELOAD_AGENT__', '$(_HotReloadBrowserToolsRuntimeHotReloadAgent)'))</_HotReloadBrowserToolsInitializerContent>
      <_HotReloadBrowserToolsInitializerContent>$(_HotReloadBrowserToolsInitializerContent.Replace('__SDK_HOT_RELOAD_AGENT__', '$(HotReloadBrowserToolsUseSdkHotReloadAgent)'))</_HotReloadBrowserToolsInitializerContent>
      <_HotReloadBrowserToolsInitializerContent>$(_HotReloadBrowserToolsInitializerContent.Replace('__SETTINGS_PATH__', '$(HotReloadBrowserToolsSettingsPath)'))</_HotReloadBrowserToolsInitializerContent>
      <_HotReloadBrowserToolsInitializerContent>$(_HotReloadBrowserToolsInitializerContent.Replace('__CONFIG_MODULE__', './$(_HotReloadBrowserToolsConfigFileName)'))</_HotReloadBrowserToolsInitializerContent>

      <_HotReloadBrowserToolsConfigContent>$([System.IO.File]::ReadAllText('$(_HotReloadBrowserToolsConfigTemplate)'))</_HotReloadBrowserToolsConfigContent>
      <_HotReloadBrowserToolsConfigContent>$(_HotReloadBrowserToolsConfigContent.Replace('__CLIENT_MODULE__', '$(_HotReloadBrowserToolsClientFileName)'))</_HotReloadBrowserToolsConfigContent>
      <_HotReloadBrowserToolsConfigContent>$(_HotReloadBrowserToolsConfigContent.Replace('__ROUTE_PREFIX__', '$(HotReloadBrowserToolsRoutePrefix)'))</_HotReloadBrowserToolsConfigContent>
      <_HotReloadBrowserToolsConfigContent>$(_HotReloadBrowserToolsConfigContent.Replace('__PUBLIC_KEY__', '$(_HotReloadBrowserToolsPublicKey)'))</_HotReloadBrowserToolsConfigContent>
    </PropertyGroup>

    <!-- WriteOnlyWhenDifferent keeps the build incremental: the key is stable as long as the key
         pair on disk stays valid, so rebuilds must not rewrite these files. -->
    <WriteLinesToFile
      File="$(_HotReloadBrowserToolsIntermediatePath)$(_HotReloadBrowserToolsInitializerFileName)"
      Lines="$([MSBuild]::Escape($(_HotReloadBrowserToolsInitializerContent)))"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />

    <WriteLinesToFile
      File="$(_HotReloadBrowserToolsIntermediatePath)$(_HotReloadBrowserToolsConfigFileName)"
      Lines="$([MSBuild]::Escape($(_HotReloadBrowserToolsConfigContent)))"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <_HotReloadBrowserToolsInitializer Include="$(_HotReloadBrowserToolsIntermediatePath)$(_HotReloadBrowserToolsInitializerFileName)">
        <RelativePath>_framework/$(_HotReloadBrowserToolsInitializerFileName)</RelativePath>
      </_HotReloadBrowserToolsInitializer>
      <_HotReloadBrowserToolsInitializer Update="@(_HotReloadBrowserToolsInitializer)">
        <OriginalItemSpec>%(Identity)</OriginalItemSpec>
      </_HotReloadBrowserToolsInitializer>

      <_HotReloadBrowserToolsClientModule Include="$(_HotReloadBrowserToolsIntermediatePath)$(_HotReloadBrowserToolsClientFileName)">
        <RelativePath>_framework/$(_HotReloadBrowserToolsClientFileName)</RelativePath>
      </_HotReloadBrowserToolsClientModule>
      <_HotReloadBrowserToolsClientModule Include="$(_HotReloadBrowserToolsIntermediatePath)$(_HotReloadBrowserToolsConfigFileName)">
        <RelativePath>_framework/$(_HotReloadBrowserToolsConfigFileName)</RelativePath>
      </_HotReloadBrowserToolsClientModule>
      <_HotReloadBrowserToolsClientModule Update="@(_HotReloadBrowserToolsClientModule)">
        <OriginalItemSpec>%(Identity)</OriginalItemSpec>
      </_HotReloadBrowserToolsClientModule>

      <!-- The key files are not static web assets. They are tracked so that Clean removes them and
           no key material is left behind on disk. -->
      <FileWrites Include="@(_HotReloadBrowserToolsInitializer);@(_HotReloadBrowserToolsClientModule)" />
      <FileWrites Include="$(_HotReloadBrowserToolsPublicKeyFile);$(_HotReloadBrowserToolsPrivateKeyFile)" />
    </ItemGroup>

    <DefineStaticWebAssets
      CandidateAssets="@(_HotReloadBrowserToolsInitializer)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      SourceId="$(PackageId)"
      SourceType="Computed"
      ContentRoot="$(_HotReloadBrowserToolsIntermediatePath)"
      BasePath="$(StaticWebAssetBasePath)"
      AssetKind="Build"
      CopyToPublishDirectory="Never"
      AssetTraitName="JSModule"
      AssetTraitValue="JSLibraryModule"
      PropertyOverrides="AssetTraitName;AssetTraitValue">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_HotReloadBrowserToolsInitializerAsset" />
    </DefineStaticWebAssets>

    <!-- The Web SDK relies on the JS modules pipeline to define the initializer endpoint and to add
         it to the JS initializer manifest, while the WebAssembly SDK defines the endpoint itself. -->
    <ItemGroup Condition="'$(HotReloadBrowserToolsRegisterInitializerAsJSModule)' == 'true'">
      <_JSModuleStaticWebAsset Include="@(_HotReloadBrowserToolsInitializerAsset)" />
    </ItemGroup>

    <DefineStaticWebAssetEndpoints
      Condition="'$(HotReloadBrowserToolsRegisterInitializerAsJSModule)' != 'true'"
      CandidateAssets="@(_HotReloadBrowserToolsInitializerAsset)"
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <!-- The client and the generated configuration are plain modules that the initializer and the
         browser refresh TagHelper import, so they must not be reported as JS initializers. -->
    <DefineStaticWebAssets
      CandidateAssets="@(_HotReloadBrowserToolsClientModule)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      SourceId="$(PackageId)"
      SourceType="Computed"
      ContentRoot="$(_HotReloadBrowserToolsIntermediatePath)"
      BasePath="$(StaticWebAssetBasePath)"
      AssetKind="Build"
      CopyToPublishDirectory="Never">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_HotReloadBrowserToolsClientAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints
      CandidateAssets="@(_HotReloadBrowserToolsClientAsset)"
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>

  </Target>

</Project>
