<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="SourceVersion.props" />
  <PropertyGroup>
    <TargetFramework>$(SdkTargetFramework)</TargetFramework>
    <AssemblyName>OrasProject.Oras</AssemblyName>
    <RootNamespace>OrasProject.Oras</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <RunAnalyzers>false</RunAnalyzers>
    <OrasSourceDir Condition="'$(OrasSourceOverride)' == ''">$(MSBuildThisFileDirectory)Source/</OrasSourceDir>
    <OrasSourceDir Condition="'$(OrasSourceOverride)' != ''">$(OrasSourceOverride)</OrasSourceDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <Compile Include="$(OrasSourceDir)**/*.cs"
             Exclude="$(OrasSourceDir)**/bin/**/*.cs;$(OrasSourceDir)**/obj/**/*.cs"
             LinkBase="OrasProject.Oras" />
  </ItemGroup>
  <Target Name="ValidateOrasSource" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(OrasSourceDir)Registry/Remote/Auth/Client.cs')"
           Text="ORAS.NET source was not found under $(OrasSourceDir). See README.md in this project." />
  </Target>
</Project>
