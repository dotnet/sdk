<Project>
  <UsingTask TaskName="FilterAotResources" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Resources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <DynamicRoots ParameterType="System.String" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <FilteredResources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
      <WrittenFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Collections" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Resources" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var keys = new HashSet<string>(StringComparer.Ordinal);
        var explicitRoots = new HashSet<string>(StringComparer.Ordinal);
        var availableKeys = new HashSet<string>(StringComparer.Ordinal);
        foreach (var source in Sources)
        {
            foreach (Match token in Regex.Matches(File.ReadAllText(source.ItemSpec), @"\b[A-Za-z_][A-Za-z0-9_]*\b"))
                keys.Add(token.Value);
        }
        foreach (string line in File.ReadAllLines(DynamicRoots))
        {
            string key = line.Trim();
            if (key.Length != 0 && !key.StartsWith("#", StringComparison.Ordinal))
            {
                keys.Add(key);
                explicitRoots.Add(key);
            }
        }
        Directory.CreateDirectory(OutputDirectory);
        var filtered = new List<Microsoft.Build.Framework.ITaskItem>();
        var written = new List<Microsoft.Build.Framework.ITaskItem>();
        foreach (var resource in Resources)
        {
            string input = resource.GetMetadata("OutputResource");
            string output = Path.Combine(OutputDirectory, Path.GetFileName(input));
            using (var reader = new ResourceReader(input))
            using (var writer = new ResourceWriter(output))
            {
                foreach (DictionaryEntry entry in reader)
                {
                    availableKeys.Add((string)entry.Key);
                    if (!(entry.Value is string))
                        throw new InvalidDataException("AOT resource filtering supports only string resources: " + input);
                    if (keys.Contains((string)entry.Key))
                        writer.AddResource((string)entry.Key, (string)entry.Value);
                }
            }
            var item = new Microsoft.Build.Utilities.TaskItem(resource);
            item.SetMetadata("OutputResource", output);
            filtered.Add(item);
            written.Add(new Microsoft.Build.Utilities.TaskItem(output));
        }
        FilteredResources = filtered.ToArray();
        WrittenFiles = written.ToArray();
        foreach (string key in explicitRoots)
        {
            if (!availableKeys.Contains(key))
                Log.LogError("Unknown dynamic AOT resource key: " + key);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="FilterNativeCliResources" AfterTargets="CoreResGen"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_AotResource Include="@(EmbeddedResource)"
                    Condition="'%(EmbeddedResource.Namespace)' == 'Microsoft.DotNet.Cli' or
                               '%(EmbeddedResource.Namespace)' == 'Microsoft.DotNet.Cli.Commands'" />
      <_AotResourceSource Include="@(Compile)" Exclude="@(GeneratedResxSource)" />
    </ItemGroup>
    <FilterAotResources Sources="@(_AotResourceSource)" Resources="@(_AotResource)"
                        DynamicRoots="$(MSBuildThisFileDirectory)AotResourceRoots.txt"
                        OutputDirectory="$(IntermediateOutputPath)aot-resources">
      <Output TaskParameter="FilteredResources" ItemName="_FilteredAotResource" />
      <Output TaskParameter="WrittenFiles" ItemName="FileWrites" />
    </FilterAotResources>
    <ItemGroup>
      <EmbeddedResource Remove="@(_AotResource)" />
      <EmbeddedResource Include="@(_FilteredAotResource)" />
    </ItemGroup>
  </Target>
</Project>
