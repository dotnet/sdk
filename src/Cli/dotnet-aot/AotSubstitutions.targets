<Project>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <IlcArg Include="--substitution:$(MSBuildThisFileDirectory)Certificate.Substitutions.xml" Condition="'$(IncludeAspNetCoreRuntime)' != 'false'" />
    <IlcArg Include="--substitution:$(MSBuildThisFileDirectory)XmlWriter.Substitutions.xml" />
  </ItemGroup>
</Project>
