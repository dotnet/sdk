<Project>

  <ItemGroup>
    <BundledManifests Include="Microsoft.NET.Sdk.Android" FeatureBand="$(MauiFeatureBand)" Version="$(XamarinAndroidWorkloadManifestVersion)" />
    <BundledManifests Include="Microsoft.NET.Sdk.iOS" FeatureBand="$(MauiFeatureBand)" Version="$(XamarinIOSWorkloadManifestVersion)" />
    <BundledManifests Include="Microsoft.NET.Sdk.MacCatalyst" FeatureBand="$(MauiFeatureBand)" Version="$(XamarinMacCatalystWorkloadManifestVersion)" />
    <BundledManifests Include="Microsoft.NET.Sdk.macOS" FeatureBand="$(MauiFeatureBand)" Version="$(XamarinMacOSWorkloadManifestVersion)" />
    <BundledManifests Include="Microsoft.NET.Sdk.Maui" FeatureBand="$(MauiFeatureBand)" Version="$(MauiWorkloadManifestVersion)" />
    <BundledManifests Include="Microsoft.NET.Sdk.tvOS" FeatureBand="$(MauiFeatureBand)" Version="$(XamarinTvOSWorkloadManifestVersion)" />
  </ItemGroup>

  <ItemGroup>
    <BuiltinManifests Include="microsoft.net.workload.mono.toolchain.current" />
    <BuiltinManifests Include="microsoft.net.workload.emscripten.current" />
    <BuiltinManifests Include="microsoft.net.workload.emscripten.net6" />
    <BuiltinManifests Include="microsoft.net.workload.emscripten.net7" />
    <BuiltinManifests Include="microsoft.net.workload.emscripten.net8" />
    <BuiltinManifests Include="microsoft.net.workload.emscripten.net9" />
    <BuiltinManifests Include="microsoft.net.workload.emscripten.net10" />
    <BuiltinManifests Include="microsoft.net.workload.mono.toolchain.net6" />
    <BuiltinManifests Include="microsoft.net.workload.mono.toolchain.net7" />
    <BuiltinManifests Include="microsoft.net.workload.mono.toolchain.net8" />
    <BuiltinManifests Include="microsoft.net.workload.mono.toolchain.net9" />
    <BuiltinManifests Include="microsoft.net.workload.mono.toolchain.net10" />
  </ItemGroup>

  <!-- Calculate NuGet package IDs for bundled manifests -->
  <PropertyGroup>
    <!-- TODO: Not exactly sure how this value should be calculated -->
    <!--<MsiArchitectureForWorkloadManifests>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant)</MsiArchitectureForWorkloadManifests>-->
    <MsiArchitectureForWorkloadManifests>$(TargetArchitecture)</MsiArchitectureForWorkloadManifests>
  </PropertyGroup>
  <ItemGroup>
    <BundledManifests Update="@(BundledManifests)">
      <NupkgId>%(Identity).Manifest-%(FeatureBand)</NupkgId>
      <RestoredNupkgContentPath>$(NuGetPackageRoot)$([MSBuild]::ValueOrDefault('%(NupkgId)', '').ToLower())/$([MSBuild]::ValueOrDefault('%(Version)', '').ToLower())</RestoredNupkgContentPath>
      <MsiNupkgId>%(Identity).Manifest-%(FeatureBand).Msi.$(MsiArchitectureForWorkloadManifests)</MsiNupkgId>
      <RestoredMsiNupkgContentPath>$(NuGetPackageRoot)$([MSBuild]::ValueOrDefault('%(MsiNupkgId)', '').ToLower())/$([MSBuild]::ValueOrDefault('%(Version)', '').ToLower())</RestoredMsiNupkgContentPath>
    </BundledManifests>
  </ItemGroup>

  <!-- Restore workload manifests via PackageDownload -->
  <ItemGroup>
    <PackageDownload Include="@(BundledManifests->'%(NupkgId)')">
      <Version>[%(Version)]</Version>
    </PackageDownload>
  </ItemGroup>

  <ItemGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <PackageDownload Include="@(BundledManifests->'%(MsiNupkgId)')">
      <Version>[%(Version)]</Version>
    </PackageDownload>

  </ItemGroup>

  <PropertyGroup>
    <_ManifestLayoutRoot>$([MSBuild]::NormalizeDirectory('$(RedistInstallerLayoutPath)', 'sdk-manifests'))</_ManifestLayoutRoot>
    <_ManifestLayoutStatePrefix>$(IntermediateOutputPath)incremental-layout\manifests-$(ProductMonikerRid)</_ManifestLayoutStatePrefix>
    <_ManifestLayoutInputManifest>$(_ManifestLayoutStatePrefix).inputs</_ManifestLayoutInputManifest>
    <_ManifestLayoutOutputInventory>$(_ManifestLayoutStatePrefix).outputs</_ManifestLayoutOutputInventory>
    <_ManifestLayoutCompletionStamp>$(_ManifestLayoutStatePrefix).complete</_ManifestLayoutCompletionStamp>
    <_ManifestLayoutTargets>$(MSBuildThisFileFullPath)</_ManifestLayoutTargets>
  </PropertyGroup>

  <Target Name="_PrepareLayoutManifests" DependsOnTargets="_PrepareBaselineWorkloadSet">
    <Error Text="Workload manifest '%(BundledManifests.Identity)' is missing WorkloadManifest.json in '%(BundledManifests.RestoredNupkgContentPath)\data'."
           Condition="'@(BundledManifests)' != '' and !Exists('%(BundledManifests.RestoredNupkgContentPath)\data\WorkloadManifest.json')" />

    <ItemGroup>
      <ManifestContent Include="%(BundledManifests.RestoredNupkgContentPath)\data\*"
                       Condition="Exists('%(BundledManifests.RestoredNupkgContentPath)\data')"
                       DestinationPath="%(BundledManifests.FeatureBand)/$([MSBuild]::ValueOrDefault('%(BundledManifests.Identity)', '').ToLowerInvariant())/%(BundledManifests.Version)"
                       RestoredNupkgContentPath="%(BundledManifests.RestoredNupkgContentPath)"
                       WorkloadManifestId="%(BundledManifests.Identity)" />

      <ManifestContent Include="%(BundledManifests.RestoredNupkgContentPath)\data\localize\*"
                       Condition="Exists('%(BundledManifests.RestoredNupkgContentPath)\data\localize')"
                       DestinationPath="%(BundledManifests.FeatureBand)/$([MSBuild]::ValueOrDefault('%(BundledManifests.Identity)', '').ToLowerInvariant())/%(BundledManifests.Version)/localize" />
    </ItemGroup>

    <Error Text="No workload manifest content found." Condition="'@(BundledManifests)' != '' and '@(ManifestContent)' == ''" />

    <MSBuild Projects="$(RepoRoot)src\Workloads\Manifests\manifest-packages.csproj"
             Targets="GetBuiltinManifestLayoutInputs"
             Properties="ManifestDirectory=$(_ManifestLayoutRoot)">
      <Output TaskParameter="TargetOutputs" ItemName="_BuiltinManifestLayoutInput" />
    </MSBuild>

    <ItemGroup>
      <_DownloadedManifestLayoutInput Include="@(ManifestContent->'%(FullPath)')">
        <DestinationPath>$([MSBuild]::NormalizePath('$(_ManifestLayoutRoot)', '%(ManifestContent.DestinationPath)', '%(ManifestContent.Filename)%(ManifestContent.Extension)'))</DestinationPath>
      </_DownloadedManifestLayoutInput>
    </ItemGroup>

    <!-- Ownership comes from the staged payload directory shape, never from cached paths. -->
    <GetWorkloadManifestLayout
        LayoutRoot="$(_ManifestLayoutRoot)"
        SourceFiles="@(_DownloadedManifestLayoutInput);@(_BuiltinManifestLayoutInput);@(_BaselineManifestLayoutInput)">
      <Output TaskParameter="SourceFilesWithDestinations" ItemName="_ManifestLayoutInput" />
      <Output TaskParameter="ExistingOutputs" ItemName="_ExistingManifestLayoutOutput" />
      <Output TaskParameter="StaleOutputs" ItemName="_StaleManifestLayoutOutput" />
      <Output TaskParameter="OwnedDirectories" ItemName="_ManifestLayoutDirectories" />
      <Output TaskParameter="EmptyDirectories" ItemName="_EmptyManifestLayoutDirectories" />
      <Output TaskParameter="InputManifestLines" ItemName="_ManifestLayoutInputLine" />
      <Output TaskParameter="OutputInventoryLines" ItemName="_ManifestLayoutOutputLine" />
    </GetWorkloadManifestLayout>

    <ItemGroup>
      <_ExpectedManifestLayoutOutput Include="@(_ManifestLayoutInput->'%(DestinationPath)')" />
      <_MissingManifestLayoutOutput Include="@(_ExpectedManifestLayoutOutput)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>

    <WriteLinesToFile File="$(_ManifestLayoutInputManifest)"
                      Lines="@(_ManifestLayoutInputLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(_ManifestLayoutOutputInventory)"
                      Lines="@(_ManifestLayoutOutputLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ReadLinesFromFile File="$(_ManifestLayoutCompletionStamp)"
                       Condition="Exists('$(_ManifestLayoutCompletionStamp)')">
      <Output TaskParameter="Lines" PropertyName="_ManifestLayoutCompletionValue" />
    </ReadLinesFromFile>
    <Delete Files="$(_ManifestLayoutCompletionStamp)"
            Condition="'@(_MissingManifestLayoutOutput)' != '' or '@(_StaleManifestLayoutOutput)' != '' or '@(_EmptyManifestLayoutDirectories)' != '' or (Exists('$(_ManifestLayoutCompletionStamp)') and '$(_ManifestLayoutCompletionValue)' != 'complete')" />
    <OnError ExecuteTargets="_InvalidateManifestLayout" />
  </Target>

  <Target Name="_InvalidateManifestLayout">
    <Delete Files="$(_ManifestLayoutCompletionStamp)" />
  </Target>

  <Target Name="LayoutManifests"
          DependsOnTargets="_PrepareLayoutManifests"
          Inputs="@(_ManifestLayoutInput);$(_ManifestLayoutInputManifest);$(_ManifestLayoutOutputInventory);$(_ManifestLayoutTargets);$(RepoRoot)src\Workloads\Manifests\Directory.Build.targets;$(RepoRoot)src\Workloads\Manifests\manifest-packages.csproj"
          Outputs="$(_ManifestLayoutCompletionStamp)">
    <Delete Files="$(_ManifestLayoutCompletionStamp)" />
    <PrepareIncrementalLayout
        SourceFiles="@(_ManifestLayoutInput)"
        DestinationFiles="@(_ExpectedManifestLayoutOutput)"
        ExistingOutputs="@(_ExistingManifestLayoutOutput)">
      <Output TaskParameter="ExpectedOutputs" ItemName="_PreparedManifestLayoutOutput" />
      <Output TaskParameter="StaleOutputs" ItemName="_PreparedStaleManifestLayoutOutput" />
    </PrepareIncrementalLayout>
    <Delete Files="@(_PreparedStaleManifestLayoutOutput)" />
    <Copy SourceFiles="@(_ManifestLayoutInput)"
          DestinationFiles="@(_PreparedManifestLayoutOutput)"
          SkipUnchangedFiles="true" />
    <PruneEmptyLayoutDirectories LayoutRoot="$(_ManifestLayoutRoot)" Directories="@(_ManifestLayoutDirectories)" />
    <CompleteIncrementalLayout ExpectedOutputs="@(_PreparedManifestLayoutOutput)"
                               CompletionStampFile="$(_ManifestLayoutCompletionStamp)" />
  </Target>

  <PropertyGroup>
    <!-- NOTE: When setting this to true, we need to also add logic to include it in the exe installation bundle, either via a new MSI or by including it in an existing one. -->
    <GenerateBaselineWorkloadSet>false</GenerateBaselineWorkloadSet>
  </PropertyGroup>

  <Target Name="LayoutBaselineWorkloadSet" DependsOnTargets="LayoutManifests" />

  <Target Name="_PrepareBaselineWorkloadSet" Condition="'$(GenerateBaselineWorkloadSet)' == 'true'">

    <PropertyGroup>
      <WorkloadSetVersion Condition="'$(DotNetFinalVersionKind)' == 'release'">$(VersionPrefix)-baseline$(_BuildNumberLabels)</WorkloadSetVersion>
      <WorkloadSetVersion Condition="'$(DotNetFinalVersionKind)' != 'release'">$(Version)</WorkloadSetVersion>
    </PropertyGroup>

    <GetWorkloadSetFeatureBand WorkloadSetVersion="$(WorkloadSetVersion)">
      <Output TaskParameter="WorkloadSetFeatureBand" PropertyName="WorkloadSetFeatureBand" />
    </GetWorkloadSetFeatureBand>

    <PropertyGroup>
      <RealFormattedManifestPaths>$(_ManifestLayoutRoot)$(WorkloadSetFeatureBand)\workloadsets\$(WorkloadSetVersion)</RealFormattedManifestPaths>
      <_BaselineManifestInput>$(_ManifestLayoutStatePrefix).baseline.json</_BaselineManifestInput>
    </PropertyGroup>

    <ItemGroup>
      <FormattedBaselineManifest Include="{" />
      <FormattedBaselineManifest Include="&quot;%(BundledManifests.Identity)&quot;: &quot;%(BundledManifests.Version)/%(BundledManifests.FeatureBand)&quot;,"
                                 Condition="'@(BundledManifests)' != ''" />
      <FormattedBaselineManifest Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(_BaselineManifestInput)" Lines="@(FormattedBaselineManifest)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <_BaselineManifestLayoutInput Include="$([MSBuild]::NormalizePath('$(_BaselineManifestInput)'))"
                                    DestinationPath="$([MSBuild]::NormalizePath('$(RealFormattedManifestPaths)', 'baseline.workloadset.json'))" />
    </ItemGroup>
  </Target>

</Project>
