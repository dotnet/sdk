<Project Sdk="Microsoft.WixToolset.Sdk">

  <ItemGroup>
    <Compile Include="$(PkgMicrosoft_DotNet_Build_Tasks_Installers)\build\wix5\product\dotnethome_x64.wxs" />
    <Compile Include="..\directories.wxs" />
    <Compile Include="..\provider.wxs" />
  </ItemGroup>

  <ItemGroup>
    <HarvestDirectory Include="$(TemplateLayoutDirectoryToHarvest)"
                      ComponentGroupName="InstallFiles"
                      DirectoryRefId="DOTNETHOME"
                      PreprocessorVariable="DotnetSrc"
                      SuppressRegistry="true"
                      SuppressRootDirectory="true"
                      Transforms="..\..\StableFileIdForApphostTransform.xslt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WixToolset.Heat" />
    <PackageReference Include="Microsoft.WixToolset.Util.wixext" />
    <PackageReference Include="Microsoft.WixToolset.UI.wixext" />
    <PackageReference Include="Microsoft.WixToolset.Dependency.wixext" />
    <PackageReference Include="Microsoft.DotNet.Build.Tasks.Installers" />
  </ItemGroup>

  <Target Name="SetInstallerInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <!-- Templates support rebuilding the same project for multiple MSIs so we expect some properties to be passed to this project when building. -->
      <DefineConstants>$(DefineConstants);ProductName=$(BrandName) $(InstallerPlatform)</DefineConstants>
      <DefineConstants>$(DefineConstants);DependencyKeyName=$(DependencyKeyName)</DefineConstants>
    </PropertyGroup>
  </Target>

  <!-- The pinned WiX SDK uses this full constants expression as a WixBuild input. Serialize that
       same evaluated value and add it to WiX's bind inputs so property-only changes invalidate
       CoreCompile without maintaining a second property list. The compatibility test locks these
       private WiX contracts to the pinned SDK. -->
  <Target Name="IncludeTemplateMsiBuildProperties"
          BeforeTargets="CoreCompile"
          DependsOnTargets="GenerateUpgradeCode;SetInstallerInfo;_CreateProjectDefineConstants">
    <WriteLinesToFile File="$(IntermediateOutputPath)template-msi-build.properties"
                      Lines="$(DefineConstants);$(SolutionDefineConstants);$(ProjectDefineConstants);$(ProjectReferenceDefineConstants)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <_BindInputs Include="$(IntermediateOutputPath)template-msi-build.properties" />
    </ItemGroup>
  </Target>

  <!-- The pinned Heat targets populate this private item before evaluating HarvestDirectory.
       The completion stamp represents layout removals that current directory contents cannot infer. -->
  <Target Name="IncludeTemplateMsiIncrementalInputs"
          AfterTargets="GetHarvestDirectoryContent">
    <ItemGroup>
      <_HarvestDirectoryContent Include="$(TemplateLayoutCompletionStamp)"
                               Condition="'$(TemplateLayoutCompletionStamp)' != ''" />
    </ItemGroup>
  </Target>

</Project>
