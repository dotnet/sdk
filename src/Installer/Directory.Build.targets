<Project InitialTargets="_EnsureDotnetupTargetFramework">
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <Target Name="_EnsureDotnetupTargetFramework">
    <Error Condition="'$(SdkTargetFramework)' != '$(DotnetupRequiredTargetFramework)'"
           Text="dotnetup must target $(DotnetupRequiredTargetFramework), but SdkTargetFramework is '$(SdkTargetFramework)'. This usually means an inter-branch merge brought in a newer .NET toolset; reset the repository toolset files to the .NET 11 source branch instead. To intentionally move dotnetup to a new .NET version, update DotnetupRequiredTargetFramework in src/Installer/Directory.Build.props." />
  </Target>
</Project>
