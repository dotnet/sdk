<Project>
  <PropertyGroup>
    <_DotnetupMetadataToolProject>$(MSBuildThisFileDirectory)Dotnetup.VersionMetadata.csproj</_DotnetupMetadataToolProject>
    <_DotnetupMetadataTool>$(ArtifactsBinDir)Dotnetup.VersionMetadata\$(Configuration)\$(SdkTargetFramework)\Dotnetup.VersionMetadata.dll</_DotnetupMetadataTool>
    <_DotnetupMetadataSource>$(IntermediateOutputPath)DotnetupVersionMetadata.g.cs</_DotnetupMetadataSource>
  </PropertyGroup>

  <Target Name="ResolveDotnetupVersionMetadata">
    <PropertyGroup>
      <DotnetupMetadataVersion Condition="'$(DotnetupMetadataVersion)' == ''">$(Version)</DotnetupMetadataVersion>
      <DotnetupMetadataRid Condition="'$(DotnetupMetadataRid)' == ''">$(RuntimeIdentifier)</DotnetupMetadataRid>
      <DotnetupMetadataRid Condition="'$(DotnetupMetadataRid)' == ''">$(TargetRid)</DotnetupMetadataRid>
    </PropertyGroup>
  </Target>

  <Target Name="BuildDotnetupMetadataTool" Returns="$(DotnetupMetadataTaskAssembly)">
    <MSBuild Projects="$(_DotnetupMetadataToolProject)" Targets="Restore;Build"
             RemoveProperties="NoBuild;RuntimeIdentifier;PublishAot;SelfContained;_IsPublishing;DotnetupMetadataRid;DotnetupMetadataVersion"
             Properties="ArtifactsDir=$(ArtifactsDir);Configuration=$(Configuration);TargetFramework=$(SdkTargetFramework);NoBuild=false" />
    <!-- Isolate loaded MSBuild task assemblies when the tool changes in a reused node. -->
    <GetFileHash Files="$(_DotnetupMetadataTool)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_DotnetupMetadataToolHash" />
    </GetFileHash>
    <PropertyGroup>
      <DotnetupMetadataTaskAssembly>$(IntermediateOutputPath)metadata-task\%(_DotnetupMetadataToolHash.FileHash)\Dotnetup.VersionMetadata.dll</DotnetupMetadataTaskAssembly>
    </PropertyGroup>
    <Copy SourceFiles="$(_DotnetupMetadataTool)" DestinationFiles="$(DotnetupMetadataTaskAssembly)" SkipUnchangedFiles="true" Condition="!Exists('$(DotnetupMetadataTaskAssembly)')" />
  </Target>

  <Target Name="ForwardDotnetupVersionMetadata" BeforeTargets="AssignProjectConfiguration" DependsOnTargets="ResolveDotnetupVersionMetadata"
      Condition="'$(DesignTimeBuild)' != 'true' and ('$(MSBuildProjectName)' == 'dotnetup' or '$(MSBuildProjectName)' == 'dotnetup.Library')">
    <ItemGroup>
      <ProjectReference Update="..\dotnetup.Library\dotnetup.Library.csproj;..\Microsoft.Dotnet.Installation\Microsoft.Dotnet.Installation.csproj">
        <AdditionalProperties>%(ProjectReference.AdditionalProperties);DotnetupMetadataVersion=$(DotnetupMetadataVersion);DotnetupMetadataRid=$(DotnetupMetadataRid)</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>

  <Target Name="GenerateDotnetupVersionMetadata" BeforeTargets="CoreCompile"
      DependsOnTargets="ResolveDotnetupVersionMetadata;BuildDotnetupMetadataTool"
          Condition="'$(MSBuildProjectName)' == 'Microsoft.Dotnet.Installation'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)Dotnetup.VersionMetadata.proj" Targets="Execute"
             Properties="MetadataTaskAssembly=$(DotnetupMetadataTaskAssembly);MetadataOperation=generate;MetadataVersion=$(DotnetupMetadataVersion);MetadataRid=$(DotnetupMetadataRid);MetadataSource=$(_DotnetupMetadataSource)" />
    <ItemGroup>
      <Compile Include="$(_DotnetupMetadataSource)" />
      <FileWrites Include="$(_DotnetupMetadataSource)" />
    </ItemGroup>
  </Target>

  <Target Name="ValidateDotnetupVersionMetadata" DependsOnTargets="BuildDotnetupMetadataTool"
          Condition="'$(MSBuildProjectName)' == 'dotnetup' and '$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <MSBuild Projects="$(MSBuildThisFileDirectory)Dotnetup.VersionMetadata.proj" Targets="Execute"
             Properties="MetadataTaskAssembly=$(DotnetupMetadataTaskAssembly);MetadataOperation=validate;MetadataVersion=$(Version);MetadataRid=$(RuntimeIdentifier);MetadataArtifact=$(PublishDir)$(TargetName)$(_DotnetupNativeBinaryExt)" />
  </Target>
</Project>
