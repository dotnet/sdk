<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="RuntimeIdentifier;RuntimeIdentifiers;PublishAot;SelfContained;_IsPublishing">
  <PropertyGroup>
    <!-- NuGet's restore graph walk can forward product globals despite ProjectReference metadata. -->
    <RuntimeIdentifier />
    <RuntimeIdentifiers />
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <_IsPublishing>false</_IsPublishing>
    <TargetFramework>$(SdkTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsShipping>false</IsShipping>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="VersionMetadataTask.cs;VersionMetadataSource.cs" />
    <Compile Include="..\Microsoft.Dotnet.Installation\Internal\VersionMetadata\DotnetupVersionMetadataReader.cs" Link="DotnetupVersionMetadataReader.cs" />
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildBinPath)\Microsoft.Build.Framework.dll" Private="false" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildBinPath)\Microsoft.Build.Utilities.Core.dll" Private="false" />
  </ItemGroup>
</Project>